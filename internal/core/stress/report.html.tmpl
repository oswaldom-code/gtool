<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stress Report</title>
<style>
:root {
  --bg: #ffffff; --surface: #f6f7f9; --text: #1d2330; --muted: #5f6b7a; --border: #dde2e8;
  --p50: #2f7ed8; --p95: #e08a1e; --p99: #b8458f; --errors: #d64545; --client: #7a8696;
  --degradation: #e0a800; --breaking: #d64545; --pass: #1f8a4c; --fail: #d64545;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #14171c; --surface: #1d2129; --text: #e6e9ee; --muted: #9aa5b4; --border: #2e3440;
    --p50: #5aa2ec; --p95: #f0a64a; --p99: #d877b4; --errors: #ef6b6b; --client: #9aa5b4;
    --degradation: #f2c94c; --breaking: #ef6b6b; --pass: #4cc38a; --fail: #ef6b6b;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
main { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 22px; margin: 0 0 4px; }
h2 { font-size: 16px; margin: 32px 0 12px; }
.muted { color: var(--muted); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 20px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
.card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.card .value { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
.card .reason { color: var(--muted); font-size: 12px; }
.pass { color: var(--pass); } .fail { color: var(--fail); }
.chart { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 8px; }
.chart svg { width: 100%; height: auto; display: block; }
.chart text { fill: var(--muted); font-size: 11px; }
.chart .axis { stroke: var(--border); }
.chart .grid { stroke: var(--border); stroke-dasharray: 2 4; }
.chart polyline { fill: none; stroke-width: 2; }
.chart .threshold { stroke: var(--muted); stroke-dasharray: 6 4; }
.chart .marker { stroke-width: 1.5; stroke-dasharray: 4 3; }
.p50 { stroke: var(--p50); fill: var(--p50); } .p95 { stroke: var(--p95); fill: var(--p95); }
.p99 { stroke: var(--p99); fill: var(--p99); } .errors { stroke: var(--errors); fill: var(--errors); }
.client { stroke: var(--client); fill: var(--client); }
.degradation { stroke: var(--degradation); } .breaking { stroke: var(--breaking); }
.chart text.degradation { fill: var(--degradation); stroke: none; } .chart text.breaking { fill: var(--breaking); stroke: none; }
.legend { display: flex; flex-wrap: wrap; gap: 16px; padding: 4px 8px 0; color: var(--muted); font-size: 12px; }
.legend i { display: inline-block; width: 12px; height: 3px; margin-right: 6px; vertical-align: middle; }
.legend i.p50 { background: var(--p50); } .legend i.p95 { background: var(--p95); } .legend i.p99 { background: var(--p99); }
.legend i.errors { background: var(--errors); } .legend i.client { background: var(--client); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
th, td { padding: 6px 10px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
th { color: var(--muted); font-weight: 600; font-size: 12px; }
th:first-child, td:first-child, td.text { text-align: left; }
tr.is-degradation td:first-child { box-shadow: inset 3px 0 var(--degradation); }
tr.is-breaking td:first-child { box-shadow: inset 3px 0 var(--breaking); }
ul.warnings { padding-left: 18px; }
code { font-size: 12px; }
</style>
</head>
<body>
<main>
<h1>Stress report</h1>
<div class="muted">{{.TargetURL}} · {{len .Targets}} targets · ramp {{.Ramp.StartRPS}}→{{.Ramp.MaxRPS}} rps (+{{.Ramp.StepRPS}} every {{.Ramp.StepDuration}}) · {{.GeneratedText}}</div>

<div class="cards">
  <div class="card">
    <div class="label">Degradation point</div>
    {{with .Degradation}}<div class="value">{{.RPS}} rps</div><div class="reason">{{.Reason}}</div>
    {{else}}<div class="value">not reached</div>{{end}}
  </div>
  <div class="card">
    <div class="label">Breaking point</div>
    {{with .Breaking}}<div class="value">{{.RPS}} rps</div><div class="reason">{{.Reason}}</div>
    {{else}}<div class="value">not reached</div>{{end}}
  </div>
  <div class="card">
    <div class="label">Max sustained</div>
    <div class="value">{{.MaxSustainedRPS}} rps</div>
    {{if gt .MinAcceptableRPS 0}}<div class="reason">min acceptable {{.MinAcceptableRPS}} rps:
      {{if .Passed}}<span class="pass">PASS</span>{{else}}<span class="fail">FAIL</span>{{end}}</div>{{end}}
  </div>
</div>

{{define "chart"}}
<div class="chart">
<svg viewBox="0 0 {{.Width}} {{.Height}}" role="img" aria-label="{{.YLabel}} by requested rps">
  {{range .YTicks}}<line class="grid" x1="{{$.Left}}" x2="{{$.Right}}" y1="{{.Pos}}" y2="{{.Pos}}"/>
  <text x="{{$.Left}}" dx="-6" y="{{.Pos}}" dy="4" text-anchor="end">{{.Label}}</text>{{end}}
  <line class="axis" x1="{{.Left}}" x2="{{.Right}}" y1="{{.Bottom}}" y2="{{.Bottom}}"/>
  {{range .XTicks}}<text x="{{.Pos}}" y="{{$.Bottom}}" dy="16" text-anchor="middle">{{.Label}}</text>{{end}}
  <text x="{{.Right}}" y="{{.Height}}" dy="-2" text-anchor="end">requested rps</text>
  <text x="4" y="{{.Top}}" dy="-4">{{.YLabel}}</text>
  {{with .Threshold}}<line class="threshold" x1="{{$.Left}}" x2="{{$.Right}}" y1="{{.Pos}}" y2="{{.Pos}}"/>
  <text x="{{$.Right}}" y="{{.Pos}}" dy="-4" text-anchor="end">{{.Label}}</text>{{end}}
  {{range .Markers}}<line class="marker {{.Class}}" x1="{{.X}}" x2="{{.X}}" y1="{{$.Top}}" y2="{{$.Bottom}}"/>
  <text class="{{.Class}}" x="{{.X}}" dx="{{.LabelDX}}" y="{{.LabelY}}" text-anchor="{{.Anchor}}">{{.Label}}</text>{{end}}
  {{range .Series}}{{$class := .Class}}<polyline class="{{$class}}" points="{{.Points}}"/>
  {{range .Dots}}<circle class="{{$class}}" cx="{{.X}}" cy="{{.Y}}" r="3"/>{{end}}{{end}}
</svg>
<div class="legend">{{range .Series}}<span><i class="{{.Class}}"></i>{{.Name}}</span>{{end}}</div>
</div>
{{end}}

<h2>Latency</h2>
{{template "chart" .LatencyChart}}

<h2>Error rate</h2>
{{template "chart" .ErrorChart}}

<h2>Stages</h2>
<div class="table-wrap">
<table>
  <thead><tr><th>Requested rps</th><th>Achieved rps</th><th>Throughput</th><th>Requests</th>
    <th>p50 ms</th><th>p95 ms</th><th>p99 ms</th><th>max ms</th><th>Errors</th><th>4xx</th></tr></thead>
  <tbody>
  {{range $i, $s := .Stages}}
  <tr class="{{with $.Degradation}}{{if eq .Stage $i}}is-degradation{{end}}{{end}} {{with $.Breaking}}{{if eq .Stage $i}}is-breaking{{end}}{{end}}">
    <td>{{$s.RequestedRPS}}</td><td>{{f1 $s.AchievedRPS}}</td><td>{{f1 $s.ThroughputRPS}}</td><td>{{$s.Requests}}</td>
    <td>{{f1 $s.LatencyMs.P50}}</td><td>{{f1 $s.LatencyMs.P95}}</td><td>{{f1 $s.LatencyMs.P99}}</td><td>{{f1 $s.LatencyMs.Max}}</td>
    <td>{{pct $s.ErrorRate}}</td><td>{{pct $s.ClientErrorRate}}</td>
  </tr>
  {{end}}
  </tbody>
</table>
</div>

<h2>Targets</h2>
<div class="table-wrap">
<table>
  <thead><tr><th>Name</th><th>Method</th><th>Path</th><th>Weight</th><th>Source</th></tr></thead>
  <tbody>
  {{range .Targets}}<tr><td>{{.Name}}</td><td class="text">{{.Method}}</td><td class="text"><code>{{.Path}}</code></td><td>{{.Weight}}</td><td class="text">{{.Source}}</td></tr>{{end}}
  </tbody>
</table>
</div>

{{if .Warnings}}
<h2>Warnings</h2>
<ul class="warnings">{{range .Warnings}}<li>{{.}}</li>{{end}}</ul>
{{end}}

<p class="muted">Thresholds: p95 &gt; {{f1 .Thresholds.DegradationLatencyFactor}}× baseline{{if gt .Thresholds.DegradationP95Ms 0}} or &gt; {{.Thresholds.DegradationP95Ms}} ms{{end}}, or throughput &lt; 90% of requested → degradation; error rate &gt; {{pct .Thresholds.BreakErrorRate}} → breaking.
Measurements are relative to the host that ran the pipeline, not a production capacity estimate.</p>
</main>
</body>
</html>
